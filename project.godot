; Open this file with Godot 4.3 or newer (Android editor supported).
config_version=5

[application]
config/name="Dominion '99 (Lite)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.015,0.02,0.03,1)

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=1024
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.06, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false
